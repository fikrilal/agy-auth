  "description": "Multi-account switcher for Google Antigravity CLI (agy)",
  "license": "MIT",
  "author": "ahmad fikril <fikrildev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikrilal/agy-auth.git"
  },
  "homepage": "https://github.com/fikrilal/agy-auth#readme",
  "bugs": {
    "url": "https://github.com/fikrilal/agy-auth/issues"
  },
